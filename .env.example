# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ─── Frappe dashboard (compose.frappe.yml) ────────────────────
FRAPPE_URL=https://teebatkarbala.frappe.cloud
# Frappe > search "API Access" on your User doc > Generate Keys
# The secret is shown only once, at generation time.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
# Host port for the Frappe Grafana (3000 is taken by the LGTM stack)
FRAPPE_GRAFANA_PORT=3001
# Host port for the Frappe Prometheus (9090 is taken by the LGTM stack)
FRAPPE_PROM_PORT=9091

# ─── Frappe Cloud platform API (optional) ─────────────────────
# Frappe Cloud's own monitoring: server-side request counts and response times,
# background jobs, uptime, plan usage. Different credentials from the site keys
# above — generate these on the Frappe Cloud dashboard account, not on the site:
#   https://cloud.frappe.io  >  your account  >  API access  >  Generate keys
# frappecloud.com redirects to cloud.frappe.io; use the cloud.frappe.io host.
FRAPPE_CLOUD_URL=https://cloud.frappe.io
FRAPPE_CLOUD_API_KEY=
FRAPPE_CLOUD_API_SECRET=
# The site the platform panels report on, as named in Frappe Cloud
FRAPPE_CLOUD_SITE=teebatkarbala.frappe.cloud
