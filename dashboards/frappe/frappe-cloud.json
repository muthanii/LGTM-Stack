      "title": "Status",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "frappe-cloud"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "mappings": [
            {
              "type": "value",
              "options": {
                "Active": {
                  "text": "ACTIVE",
                  "color": "green",
                  "index": 0
                },
                "Inactive": {
                  "text": "INACTIVE",
                  "color": "orange",
                  "index": 1
                },
                "Suspended": {
                  "text": "SUSPENDED",
                  "color": "red",
                  "index": 2
                },
                "Broken": {
                  "text": "BROKEN",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "frappe-cloud"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/method/press.api.site.get",
          "url_options": {
            "method": "GET",
